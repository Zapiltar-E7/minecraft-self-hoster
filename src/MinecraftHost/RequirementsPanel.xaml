<UserControl x:Class="MinecraftHost.RequirementsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Set up this PC" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"
               Text="Everything the server, the playit.gg tunnel and the web map link need. Downloads come from the official sources and are checked before use."/>
    <StackPanel x:Name="Rows"/>
    <TextBlock x:Name="LblStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="2,6,0,0" MinHeight="18"/>
    <DockPanel Margin="0,16,0,0">
      <Button x:Name="BtnInstall" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Install_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE896;" VerticalAlignment="Center" Margin="0,1,8,0"/>
          <TextBlock x:Name="LblInstall" Text="Install missing"/>
        </StackPanel>
      </Button>
      <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Close" Margin="0,0,8,0" FontWeight="Normal" IsCancel="True" Click="Close_Click"/>
      <Button x:Name="BtnRecheck" DockPanel.Dock="Left" HorizontalAlignment="Left" FontWeight="Normal" Click="Recheck_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE72C;" VerticalAlignment="Center" Margin="0,1,8,0"/>
          <TextBlock Text="Check again"/>
        </StackPanel>
      </Button>
    </DockPanel>
  </StackPanel>
</UserControl>
