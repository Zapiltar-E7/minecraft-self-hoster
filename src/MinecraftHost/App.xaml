<Application x:Class="MinecraftHost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MinecraftHost"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- palette: the Default theme; Themes.cs recolours these brushes for the other themes -->
    <SolidColorBrush x:Key="Bg" Color="#16171A"/>
    <SolidColorBrush x:Key="Card" Color="#1F2125"/>
    <SolidColorBrush x:Key="CardBorder" Color="#2A2D33"/>
    <SolidColorBrush x:Key="Field" Color="#26292E"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#353941"/>
    <SolidColorBrush x:Key="Text" Color="#ECEDEF"/>
    <SolidColorBrush x:Key="Muted" Color="#8E939C"/>
    <SolidColorBrush x:Key="Accent" Color="#7CC4FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#9AD3FF"/>
    <!-- text and icons on the light blue accent -->
    <SolidColorBrush x:Key="OnAccent" Color="#0E1A24"/>
    <SolidColorBrush x:Key="Danger" Color="#D83C3E"/>
    <SolidColorBrush x:Key="DangerHover" Color="#E5524F"/>
    <SolidColorBrush x:Key="Neutral" Color="#30333A"/>
    <SolidColorBrush x:Key="NeutralHover" Color="#3B3F47"/>
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF"/>
    <!-- switch tracks, scrollbars, menus, lists -->
    <SolidColorBrush x:Key="Track" Color="#3A3E46"/>
    <SolidColorBrush x:Key="Knob" Color="#C9CCD1"/>
    <SolidColorBrush x:Key="Popup" Color="#2B2E34"/>
    <SolidColorBrush x:Key="Selected" Color="#243445"/>
    <SolidColorBrush x:Key="Row" Color="#24272C"/>
    <!-- the log and the config text editor -->
    <SolidColorBrush x:Key="Console" Color="#121316"/>
    <SolidColorBrush x:Key="ConsoleText" Color="#C9CDD3"/>
    <!-- dimming behind panels and the help tour -->
    <SolidColorBrush x:Key="Scrim" Color="#B3101114"/>
    <SolidColorBrush x:Key="ScrimStrong" Color="#CC101114"/>
    <!-- warnings (amber), problems (light red), stopped / unknown (grey) -->
    <SolidColorBrush x:Key="Warn" Color="#F0B232"/>
    <SolidColorBrush x:Key="WarnText" Color="#F0D28A"/>
    <SolidColorBrush x:Key="WarnBg" Color="#2B2614"/>
    <SolidColorBrush x:Key="WarnBorder" Color="#5C4A12"/>
    <SolidColorBrush x:Key="WarnEdge" Color="#B8902A"/>
    <SolidColorBrush x:Key="Bad" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="Idle" Color="#80848E"/>
    <SolidColorBrush x:Key="Unknown" Color="#5D626B"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <local:HealthToBrushConverter x:Key="HealthToBrush"/>
    <local:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- buttons: rounded, flat, with hover/pressed states -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Neutral}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Tag" Value="{DynamicResource NeutralHover}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="local:Motion.Hover" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
              <Grid>
                <!-- the hover colour (Tag), faded in by Motion.Hover -->
                <Border x:Name="Hover" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="7" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Tag" Value="{DynamicResource AccentHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Danger}"/>
      <Setter Property="Tag" Value="{DynamicResource DangerHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
    </Style>
    <!-- small square icon button -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
    <!-- tool button: icon + text, left aligned -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- toggle switch made from a CheckBox -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="local:SwitchAnimation.Enabled" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <!-- the "on" track and knob colour sit on top of the "off" ones and fade in -->
              <Grid Width="38" Height="20" VerticalAlignment="Center">
                <Border CornerRadius="10" Background="{DynamicResource Track}"/>
                <Border x:Name="TrackOn" CornerRadius="10" Background="{DynamicResource Accent}" Opacity="0"/>
                <Grid x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Ellipse Fill="{DynamicResource Knob}"/>
                  <Ellipse x:Name="KnobOn" Fill="{DynamicResource OnAccent}" Opacity="0"/>
                </Grid>
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- resting state; SwitchAnimation plays the slide and fade when the user flips it -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="TrackOn" Property="Opacity" Value="1"/>
                <Setter TargetName="KnobOn" Property="Opacity" Value="1"/>
                <Setter TargetName="Knob" Property="Margin" Value="21,0,0,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- cards and text -->
    <!-- a section of a page: no box, just a hairline under it (the sidebar layout keeps pages flat) -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0,4,0,20"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <!-- a whole-page area (a list, an editor, the console): flat, no hairline -->
    <Style x:Key="PaneStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <!-- something that needs noticing (setup missing, disk nearly full): still a filled, rounded box -->
    <Style x:Key="BannerStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource WarnBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WarnBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>

    <!-- read-only value field (address, path) -->
    <Style x:Key="Value" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="7" Padding="8,0" Height="30">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- editable input -->
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="7" Padding="8,0" MinHeight="32">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- top tabs (RadioButtons in the header) -->
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="local:Motion.Hover" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
              <Grid>
                <Border x:Name="Hover" Background="{DynamicResource Card}" CornerRadius="8" Opacity="0"/>
                <ContentPresenter Margin="14,7" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Neutral}"/>
                <Setter TargetName="Hover" Property="Visibility" Value="Collapsed"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the sidebar's page buttons: full width; the open one's highlight (NavMarker) slides between them (Motion.Track) -->
    <Style x:Key="NavButton" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
              <Grid>
                <Border x:Name="Hover" Background="{DynamicResource Neutral}" CornerRadius="7" Opacity="0"/>
                <ContentPresenter Margin="12,8" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Collapsed"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- sections within a page (Server: General, Players...; Configs: Server, Plugins...): the open one's underline
         is a marker that slides between them (Motion.Track) -->
    <Style x:Key="SubTab" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
      <Setter Property="Margin" Value="0,0,22,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,0,-1">
              <ContentPresenter Margin="0,6,0,9" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- small toggle chips (the log filters) -->
    <Style x:Key="FilterChip" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
              <Grid>
                <Border x:Name="Hover" Background="{DynamicResource Field}" CornerRadius="7" Opacity="0"/>
                <ContentPresenter Margin="10,5" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Neutral}"/>
                <Setter TargetName="Hover" Property="Visibility" Value="Collapsed"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- one line of the server log: tight, selectable -->
    <Style x:Key="LogLine" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="12,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- dark list (config file picker) -->
    <!-- the Appearance pickers (Settings): a list laid out as tiles or swatches, scrolled with the page, not on its own -->
    <Style x:Key="PickerList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- a menu colour tile: a ring in the highlight colour around the picked one -->
    <Style x:Key="LookTile" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="local:Motion.Hover" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Background="Transparent">
              <Border x:Name="Hover" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="2" CornerRadius="11" Opacity="0"/>
              <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="11"/>
              <ContentPresenter Margin="5,5,5,6"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Hover" Property="Visibility" Value="Collapsed"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- a highlight colour swatch: a ring in the text colour around the picked one -->
    <Style x:Key="LookSwatch" TargetType="ListBoxItem" BasedOn="{StaticResource LookTile}">
      <Setter Property="Margin" Value="0,0,2,2"/>
      <Setter Property="ToolTip" Value="{Binding Label}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Background="Transparent">
              <Border x:Name="Hover" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="2" CornerRadius="17" Opacity="0"/>
              <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="17"/>
              <ContentPresenter Margin="5"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Text}"/>
                <Setter TargetName="Hover" Property="Visibility" Value="Collapsed"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,5" Margin="0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Field}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- dark dropdown -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeutralHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Focusable="False" ClickMode="Press" Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="7" MinHeight="32">
                      <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70D;" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,10,0" Foreground="{DynamicResource Muted}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"
                                Margin="10,0,30,0" VerticalAlignment="Center"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="7"
                        Padding="4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slim dark scrollbars -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource Track}" CornerRadius="4" Margin="1,2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="{DynamicResource Track}" CornerRadius="4" Margin="2,1"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- hover tooltips: dark, rounded, wrapping (replaces the white Windows ones everywhere) -->
    <Style TargetType="ToolTip">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="7" Padding="10,6" MaxWidth="460">
              <ContentPresenter>
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="LineHeight" Value="17"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- right-click menus (including the Cut/Copy/Paste menu of text boxes) -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="170">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" Margin="24,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Track}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{DynamicResource FieldBorder}" Margin="6,4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
